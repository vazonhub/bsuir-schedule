{
  "expo": {
    "name": "Bsuir Time",
    "slug": "bsuir-schedule",
    "scheme": "bsuirtime",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-logo.png",
      "backgroundColor": "#3A547F"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "by.vazon.bsuirschedule",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleLocalizations": ["en", "ru", "be"]
      },
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.by.vazon.bsuirschedule"
        ],
        "com.apple.developer.icloud-container-identifiers": [],
        "com.apple.developer.ubiquity-kvstore-identifier": "$(TeamIdentifierPrefix)by.vazon.bsuirschedule"
      }
    },
    "android": {
      "package": "by.vazon.bsuirschedule",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon.png",
        "backgroundColor": "#ffffff"
      },
      "icon": "./assets/android-icon.png",
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "./plugins/withWidget",
      "./plugins/withWidgetKitBridge",
      "./plugins/withICloudKVStore",
      "./plugins/withStoreKit",
      [
        "expo-alternate-app-icons",
        [
          "./assets/icons/IconBgDark.png",
          "./assets/icons/IconBgRed.png",
          "./assets/icons/IconBgOrange.png",
          "./assets/icons/IconBgGreen.png",
          "./assets/icons/IconBgPurple.png",
          "./assets/icons/IconBgBlue.png",
          "./assets/icons/IconBgPink.png",
          "./assets/icons/IconBgTeal.png",
          "./assets/icons/IconLightClassicBlue.png",
          "./assets/icons/IconLightBlack.png",
          "./assets/icons/IconLightBlue.png",
          "./assets/icons/IconLightPurple.png",
          "./assets/icons/IconLightRed.png",
          "./assets/icons/IconLightGreen.png",
          "./assets/icons/IconDarkBlue.png",
          "./assets/icons/IconDarkGreen.png",
          "./assets/icons/IconDarkRed.png",
          "./assets/icons/IconDarkOrange.png",
          "./assets/icons/IconDarkPurple.png",
          "./assets/icons/IconGradBluePurple.png",
          "./assets/icons/IconGradRedOrange.png",
          "./assets/icons/IconGradGreenTeal.png",
          "./assets/icons/IconGradPinkPurple.png",
          "./assets/icons/IconGradMidnight.png"
        ]
      ],
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-logo.png",
          "imageWidth": 200,
          "backgroundColor": "#3A547F",
          "dark": {
            "image": "./assets/splash-logo.png",
            "imageWidth": 200,
            "backgroundColor": "#000000"
          }
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "15.1"
          }
        }
      ],
      ["./plugins/withAndroidAccentColor", "#0A84FF"],
      ["react-native-android-widget", {
        "widgets": [
          {
            "name": "ScheduleSmall",
            "label": "Bsuir Time",
            "minWidth": "110dp",
            "minHeight": "110dp",
            "targetCellWidth": 2,
            "targetCellHeight": 2,
            "description": "Расписание занятий",
            "updatePeriodMillis": 1800000
          },
          {
            "name": "ScheduleMedium",
            "label": "Bsuir Time (средний)",
            "minWidth": "250dp",
            "minHeight": "110dp",
            "targetCellWidth": 4,
            "targetCellHeight": 2,
            "description": "Расписание занятий",
            "updatePeriodMillis": 1800000
          },
          {
            "name": "ScheduleLarge",
            "label": "Bsuir Time (большой)",
            "minWidth": "250dp",
            "minHeight": "250dp",
            "targetCellWidth": 4,
            "targetCellHeight": 4,
            "description": "Расписание занятий",
            "updatePeriodMillis": 1800000
          }
        ]
      }],
      "react-native-iap",
      "@react-native-google-signin/google-signin"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "fcba8170-b003-44b7-9203-ece1a99b2162",
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "targetName": "ScheduleWidget",
                  "bundleIdentifier": "by.vazon.bsuirschedule.widget",
                  "entitlements": {
                    "com.apple.security.application-groups": [
                      "group.by.vazon.bsuirschedule"
                    ]
                  }
                }
              ]
            }
          }
        }
      }
    },
    "owner": "kostyabet228"
  }
}
