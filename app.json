        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "15.1"
          },
          "android": {
            "enableProguardInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "extraProguardRules": "# Keep our app + widget provider classes referenced by reflection from the manifest.\n-keep class by.vazon.bsuirtime.** { *; }\n# react-native-android-widget resolves widget classes by name.\n-keep class com.reactnativeandroidwidget.** { *; }\n# Keep annotated members RN/Expo native modules access via reflection.\n-keepclassmembers class * { @com.facebook.react.bridge.ReactMethod <methods>; }"
          }
        }
      ],
      ["./plugins/withAndroidAccentColor", "#0A84FF"],
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "ScheduleSmall",
              "label": "Bsuir Time",
              "minWidth": "110dp",
              "minHeight": "110dp",
              "targetCellWidth": 2,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "description": "Расписание занятий",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "ScheduleMedium",
              "label": "Bsuir Time (средний)",
              "minWidth": "250dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "description": "Расписание занятий",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "ScheduleLarge",
              "label": "Bsuir Time (большой)",
              "minWidth": "250dp",
              "minHeight": "250dp",
              "targetCellWidth": 4,
              "targetCellHeight": 4,
