{
  "expo": {
    "name": "Bsuir Time",
    "slug": "bsuir-schedule",
    "scheme": "bsuirtime",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-logo.png",
      "backgroundColor": "#3A547F"
