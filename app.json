{
  "expo": {
    "name": "Bsuir Time",
    "slug": "bsuir-schedule",
    "scheme": "bsuirtime",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-logo.png",
      "backgroundColor": "#3A547F"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "by.vazon.bsuirschedule",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.by.vazon.bsuirschedule"
        ],
        "com.apple.developer.ubiquity-kvstore-identifier": "$(TeamIdentifierPrefix)by.vazon.bsuirschedule"
      }
    },
    "android": {
      "package": "by.vazon.bsuirschedule",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "./plugins/withWidget",
      "./plugins/withICloudKVStore",
      "./plugins/withStoreKit",
      [
        "expo-alternate-app-icons",
        [
          "./assets/icons/icon-bg-dark.png",
          "./assets/icons/icon-bg-red.png",
          "./assets/icons/icon-bg-orange.png",
          "./assets/icons/icon-bg-green.png",
          "./assets/icons/icon-bg-purple.png",
          "./assets/icons/icon-bg-blue.png",
          "./assets/icons/icon-bg-pink.png",
          "./assets/icons/icon-bg-teal.png",
          "./assets/icons/icon-light-classic-blue.png",
          "./assets/icons/icon-light-black.png",
          "./assets/icons/icon-light-blue.png",
          "./assets/icons/icon-light-purple.png",
          "./assets/icons/icon-light-red.png",
          "./assets/icons/icon-light-green.png",
          "./assets/icons/icon-dark-blue.png",
          "./assets/icons/icon-dark-green.png",
          "./assets/icons/icon-dark-red.png",
          "./assets/icons/icon-dark-orange.png",
          "./assets/icons/icon-dark-purple.png",
          "./assets/icons/icon-grad-blue-purple.png",
          "./assets/icons/icon-grad-red-orange.png",
          "./assets/icons/icon-grad-green-teal.png",
          "./assets/icons/icon-grad-pink-purple.png",
          "./assets/icons/icon-grad-midnight.png"
        ]
      ],
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-logo.png",
          "imageWidth": 200,
          "backgroundColor": "#3A547F",
          "dark": {
            "image": "./assets/splash-logo.png",
            "imageWidth": 200,
            "backgroundColor": "#000000"
          }
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "15.1"
          }
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "fcba8170-b003-44b7-9203-ece1a99b2162",
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "targetName": "ScheduleWidget",
                  "bundleIdentifier": "by.vazon.bsuirschedule.widget",
                  "entitlements": {
                    "com.apple.security.application-groups": [
                      "group.by.vazon.bsuirschedule"
                    ]
                  }
                }
              ]
            }
          }
        }
      }
    },
    "owner": "kostyabet228"
  }
}
