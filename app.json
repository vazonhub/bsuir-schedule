                  "targetName": "BsuirWatch",
                  "bundleIdentifier": "by.vazon.bsuirschedule.watchapp",
                  "entitlements": {
                    "com.apple.security.application-groups": ["group.by.vazon.bsuirschedule"]
                  }
                },
                {
