{
  "name": "bsuir-time",
  "version": "3.1.0",
  "description": "Bsuir Time — BSUIR class schedule app for iOS and Android: 4-week cycle, widgets, diary, cloud sync",
  "license": "MIT",
  "author": "Konstantsin Betenya",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vazonhub/bsuir-schedule.git"
  },
  "homepage": "https://github.com/vazonhub/bsuir-schedule#readme",
  "bugs": {
    "url": "https://github.com/vazonhub/bsuir-schedule/issues"
  },
  "main": "./index.ts",
  "private": true,
  "scripts": {
    "bump:patch": "npm version patch --no-git-tag-version && npm run bump:build",
    "bump:minor": "npm version minor --no-git-tag-version && npm run bump:build",
    "bump:major": "npm version major --no-git-tag-version && npm run bump:build",
    "bump:build": "node scripts/bump-build.js",
    "start": "expo start",
    "ios": "expo run:ios --scheme BsuirTime",
    "android": "expo run:android",
    "web": "expo start --web",
    "prebuild": "expo prebuild",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "format": "prettier --write \"**/*.{js,ts,tsx,json,md}\"",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "ios:eas": "eas build --platform ios --profile production --auto-submit",
    "ios:build": "npx expo prebuild --clean && npx expo run:ios --scheme BsuirTime",
    "ios:watch": "bash scripts/ios-watch.sh",
    "android:eas": "eas build --platform android --profile production",
    "android:build": "npx expo prebuild --clean && npx expo run:android",
    "prepare": "husky",
    "postinstall": "patch-package",
    "format:check": "prettier --check \"**/*.{js,ts,tsx,json,md}\""
  },
  "dependencies": {
    "@expo/vector-icons": "^15.1.1",
    "@gorhom/bottom-sheet": "^5.2.9",
    "@mrnitrox/react-native-unity-ads-monetization": "^0.1.2",
    "@react-native-async-storage/async-storage": "~2.2.0",
    "@react-native-community/datetimepicker": "8.4.4",
    "@react-native-google-signin/google-signin": "^16.1.2",
    "@react-native-segmented-control/segmented-control": "^2.5.7",
    "@react-navigation/native": "^7.1.8",
    "@react-navigation/native-stack": "^7.3.16",
    "@shopify/flash-list": "2.0.2",
    "axios": "^1.18.1",
    "date-fns": "^4.1.0",
    "expo": "~54.0.33",
    "expo-accessibility-plus": "^0.1.2",
    "expo-alternate-app-icons": "^8.0.0",
    "expo-application": "~7.0.8",
    "expo-background-fetch": "~14.0.9",
    "expo-blur": "~15.0.8",
    "expo-build-properties": "~1.0.10",
    "expo-constants": "~18.0.13",
    "expo-dev-client": "~6.0.20",
    "expo-font": "~14.0.11",
    "expo-haptics": "~15.0.8",
    "expo-icloud-kv": "^0.1.2",
    "expo-image": "~3.0.11",
    "expo-linear-gradient": "~15.0.8",
    "expo-linking": "~8.0.11",
    "expo-notifications": "~0.32.17",
    "expo-router": "~6.0.24",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-store-review": "~9.0.9",
    "expo-system-ui": "~6.0.9",
    "expo-task-manager": "~14.0.9",
    "expo-widgetkit-bridge": "^0.2.0",
    "i18next": "^26.0.5",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-i18next": "^17.0.3",
    "react-native": "0.81.5",
    "react-native-android-widget": "^0.20.1",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-iap": "^14.7.20",
    "react-native-nitro-modules": "^0.35.5",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-shared-group-preferences": "^1.1.24",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.5.1",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@eslint/js": "^10.0.1",
    "@types/jest": "29.5.14",
    "@types/react": "~19.1.0",
    "@typescript-eslint/eslint-plugin": "^8.58.2",
    "@typescript-eslint/parser": "^8.58.2",
    "babel-plugin-module-resolver": "^5.0.3",
    "babel-preset-expo": "~54.0.10",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-native": "^5.0.0",
    "husky": "^9.1.7",
    "jest": "~29.7.0",
    "jest-expo": "~54.0.17",
    "lint-staged": "^17.1.0",
    "patch-package": "^8.0.1",
    "prettier": "^3.8.3",
    "typescript": "~5.9.2"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "react-native-shared-group-preferences"
        ]
      }
    }
  },
  "overrides": {
    "uuid": "^11.1.1",
    "postcss": "^8.5.10"
  }
}
