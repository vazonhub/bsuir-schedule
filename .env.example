# Copy to `.env` and fill in your own values. Every variable is optional:
# the app builds and runs without them, the related feature just stays off.

# --- EAS (cloud builds) -------------------------------------------------
# Your Expo account/organization and EAS project id (`eas init` prints both).
# Also add these to your EAS project environment variables for cloud builds,
# since `.env` is not committed.
EXPO_OWNER=
EAS_PROJECT_ID=

# --- Auditory occupancy API ---------------------------------------------
# URL of your deployed Cloudflare Worker (see services/auditory-api/README.md).
# When empty, the "auditory free/busy" feature is disabled.
EXPO_PUBLIC_AUDITORY_API_URL=

# --- Unity Ads ------------------------------------------------------------
EXPO_PUBLIC_UNITY_GAME_ID_IOS=
EXPO_PUBLIC_UNITY_GAME_ID_ANDROID=
EXPO_PUBLIC_UNITY_REWARDED_PLACEMENT_IOS=
EXPO_PUBLIC_UNITY_REWARDED_PLACEMENT_ANDROID=
EXPO_PUBLIC_UNITY_BANNER_PLACEMENT_IOS=
EXPO_PUBLIC_UNITY_BANNER_PLACEMENT_ANDROID=

# --- Google Sign-In (Google Drive sync on Android) ------------------------
# OAuth 2.0 Web client ID from Google Cloud Console.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
